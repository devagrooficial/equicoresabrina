PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — nunca prefixar com PUBLIC_ (não deve ir para o bundle do cliente)
# Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Stripe → Developers → Webhooks → endpoint apontando para /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Integração com o portal SGQ — chave AES-256 que cifra a senha do portal do veterinário.
# Gere com: openssl rand -base64 32   (se trocar a chave, os veterinários precisam reconectar)
SGQ_CRED_KEY=
